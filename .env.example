DB_URL=jdbc:postgresql://localhost:5433/orientec
DB_USERNAME=orientec
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX=10
DB_POOL_MIN=2
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Chave JWT: troque por uma chave aleatória com pelo menos 32 bytes.
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_TTL=PT24H

# Sessão da estação: o PMA pode permanecer autorizado durante o expediente.
ORIENTEC_ESTACAO_SESSAO_TTL=PT12H
ORIENTEC_ESTACAO_LAUNCH_TTL=PT1M
ORIENTEC_SECURE_COOKIE=false
